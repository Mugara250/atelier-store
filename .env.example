# Neon Postgres connection string (Neon dashboard → Connect).
# Use the pooled connection string for the app.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Base URL of the app (used for callbacks and cookies)
BETTER_AUTH_URL="http://localhost:3000"
